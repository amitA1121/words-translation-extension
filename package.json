{
  "name": "words-translation-extension",
  "description": "Chrome extension for learning English: instant Hebrew translations, word highlighting everywhere (including PDFs), flashcards, and PDF export.",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/copy-pdf-assets.mjs && wxt prepare"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wxt": "^0.20.0"
  }
}
